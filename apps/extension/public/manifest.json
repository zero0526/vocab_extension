{
  "manifest_version": 3,
  "name": "VocabExtend",
  "version": "0.1.0",
  "description": "Capture vocabulary while reading, cache in IndexedDB, and export to Anki.",
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://dictionary.cambridge.org/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "VocabExtend Quick Capture"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
